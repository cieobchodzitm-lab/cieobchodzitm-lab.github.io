# ---- The Bridge (Stoic Matrix AI) — local environment ----
# Copy to `.env.local` and adjust. Never commit `.env.local`.

# Session signing secret. MUST be a long random string in any real deployment.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BRIDGE_SESSION_SECRET=change-me-to-a-long-random-string

# Admin bootstrap credentials (only used when the database has no users yet).
BRIDGE_ADMIN_USERNAME=admin
BRIDGE_ADMIN_PASSWORD=admin123