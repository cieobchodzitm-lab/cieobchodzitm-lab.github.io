+"""Security-gate tests — audit 2026-09-06 findings C-1, C-2, C-3.
+
+Run:  cd backend && python -m pytest tests/ -q
+"""
+from __future__ import annotations
+
+import base64
+import json
+import time
+
+from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
+from cryptography.hazmat.primitives.serialization import (
+    Encoding,
+    PublicFormat,
+)
+from fastapi.testclient import TestClient
+
+import routers.passport as pr
+from main import app
+from services.cnota_scores import get_virtue_scores
+from services.passport_bridge import DOMAIN, verify_passport
+
+client = TestClient(app)
+
+_PRIV = Ed25519PrivateKey.generate()
+_PUB_PEM = _PRIV.public_key().public_bytes(
+    Encoding.PEM, PublicFormat.SubjectPublicKeyInfo
+).decode()
+
+
+def _canonical(obj: dict) -> bytes:
+    return json.dumps(obj, sort_keys=True, separators=(",", ":")).encode()
+
+
+def _make_signed(
+    *,
+    agent_class: str = "TRUSTED",
+    ts_offset_ms: int = 0,
+    domain: str = DOMAIN,
+    tamper: bool = False,
+) -> dict:
+    fingerprint = {
+        "constitutionId": "phantom-v1",
+        "agentClass": agent_class,
+        "scope": ["virtue-passport"],
+        "nonce": "test-nonce-0001",
+        "timestamp": int(time.time() * 1000) + ts_offset_ms,
+    }
+    sig = _PRIV.sign(_canonical({"domain": domain, **fingerprint}))
+    if tamper:
+        # flip the class AFTER signing — signature must no longer verify
+        fingerprint = {**fingerprint, "agentClass": "TRUSTED"}
+    return {
+        "domain": domain,
+        "fingerprint": fingerprint,
+        "signature": base64.b64encode(sig).decode(),
+        "algorithm": "ed25519",
+    }
+
+
+# ---------------- C-2: fail-closed signature verification ----------------
+
+def test_missing_key_fails_closed():
+    res = verify_passport(_make_signed(), public_key_pem=None)
+    assert res.valid is False
+    assert "fail-closed" in res.reason
+
+
+def test_structural_only_dev_mode_documented_escape():
+    res = verify_passport(_make_signed(), public_key_pem=None, structural_only=True)
+    assert res.valid is True
+
+
+def test_valid_signature_passes():
+    res = verify_passport(_make_signed(), public_key_pem=_PUB_PEM)
+    assert res.valid is True
+    assert res.agent_class == "TRUSTED"
+
+
+def test_wrong_domain_rejected():
+    res = verify_passport(_make_signed(domain="EVIL-DOMAIN"), public_key_pem=_PUB_PEM)
+    assert res.valid is False
+    assert res.reason == "domain mismatch"
+
+
+def test_stale_timestamp_rejected():
+    res = verify_passport(
+        _make_signed(ts_offset_ms=-20 * 60 * 1000), public_key_pem=_PUB_PEM
+    )
+    assert res.valid is False
+    assert "freshness" in res.reason
+
+
+def test_tampered_fingerprint_rejected():
+    signed = _make_signed(agent_class="UNTRUSTED", tamper=True)
+    res = verify_passport(signed, public_key_pem=_PUB_PEM)
+    assert res.valid is False
+    assert "invalid signature" in res.reason
+
+
+def test_untrusted_class_rejected():
+    res = verify_passport(_make_signed(agent_class="UNTRUSTED"), public_key_pem=_PUB_PEM)
+    assert res.valid is False
+    assert "not TRUSTED" in res.reason
+
+
+# ---------------- C-1: mint gate (demo path opt-in) ----------------
+
+def test_mint_without_passport_fails_closed():
+    res = client.post("/api/passport/mint", json={"user_id": "user_001"})
+    assert res.status_code == 403
+    assert res.json()["detail"]["error"] == "signed_passport_required"
+
+
+def test_mint_without_passport_demo_mode(monkeypatch):
+    monkeypatch.setenv("CNOTA_DEMO_MODE", "1")
+    res = client.post("/api/passport/mint", json={"user_id": "user_001"})
+    assert res.status_code == 200
+    assert res.json()["status"] == "queued"
+
+
+# ---------------- C-3: server-side virtue scores ----------------
+
+def test_mint_valid_passport_uses_server_scores(monkeypatch):
+    monkeypatch.setattr(pr, "_PUBLIC_KEY_PEM", _PUB_PEM)
+    uid = "user_042"
+    res = client.post(
+        "/api/passport/mint",
+        json={"user_id": uid, "signed_passport": _make_signed()},
+    )
+    assert res.status_code == 200, res.text
+    body = res.json()
+    assert body["verification"]["agent_class"] == "TRUSTED"
+    expected = get_virtue_scores(uid)
+    assert body["mint_payload"]["virtue_scores"] == expected
+    assert body["mint_payload"]["virtue_score_total"] == sum(expected.values())
+
+
+def test_client_supplied_scores_are_ignored(monkeypatch):
+    monkeypatch.setattr(pr, "_PUBLIC_KEY_PEM", _PUB_PEM)
+    uid = "user_042"
+    res = client.post(
+        "/api/passport/mint",
+        json={
+            "user_id": uid,
+            "signed_passport": _make_signed(),
+            "virtue_scores": {"sophia": 1, "andreia": 1, "dikaiosyne": 1, "sophrosyne": 1},
+        },
+    )
+    assert res.status_code == 200
+    body = res.json()
+    expected = get_virtue_scores(uid)
+    assert body["mint_payload"]["virtue_scores"] == expected
+    assert body["mint_payload"]["virtue_scores"] != {
+        "sophia": 1, "andreia": 1, "dikaiosyne": 1, "sophrosyne": 1
+    }
+
+
+def test_mint_invalid_passport_rejected(monkeypatch):
+    monkeypatch.setattr(pr, "_PUBLIC_KEY_PEM", _PUB_PEM)
+    res = client.post(
+        "/api/passport/mint",
+        json={"user_id": "user_001", "signed_passport": _make_signed(agent_class="UNTRUSTED")},
+    )
+    assert res.status_code == 403
+    assert res.json()["detail"]["error"] == "passport_verification_failed"
