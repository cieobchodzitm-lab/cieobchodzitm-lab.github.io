+"""cnota_scores.py — server-side virtue score source of truth.
+
+Mint and scoring endpoints MUST read scores from here, never from the
+client request body (audit 2026-09-06, finding C-3: self-attested scores
+= plutocratic farming vector).
+
+Currently: deterministic placeholder (CNOTA ledger not yet wired).
+TODO(L3): replace with CNOTA registry lookup + attestation ref.
+"""
+from __future__ import annotations
+
+import random
+from typing import Dict, Optional
+
+CARDINAL_VIRTUES = ("sophia", "andreia", "dikaiosyne", "sophrosyne")
+
+
+def get_virtue_scores(user_id: str) -> Optional[Dict[str, int]]:
+    """Return server-attested virtue scores for ``user_id``.
+
+    Returns None when no valid profile can be resolved for the id.
+    """
+    uid = (user_id or "").strip()
+    if not uid or len(uid) > 64 or any(ch.isspace() for ch in uid):
+        return None
+    rng = random.Random(uid)
+    return {
+        "sophia": rng.randint(55, 99),
+        "andreia": rng.randint(50, 99),
+        "dikaiosyne": rng.randint(55, 99),
+        "sophrosyne": rng.randint(50, 99),
+    }
