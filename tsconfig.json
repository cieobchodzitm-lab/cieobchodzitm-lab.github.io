{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // nexusvault/ to osobny projekt Vite z własnym package.json. Bez tego
  // wykluczenia `next build` typecheckowałby jego pliki, a główny `npm ci`
  // nie instaluje vitest ani @testing-library — build kończyłby się 7 błędami
  // TS2307 „Cannot find module" (sprawdzone kontrfaktycznie).
  "exclude": ["node_modules", "legacy", "rnd", "scripts", "nexusvault"]
}